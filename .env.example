# Server bind address (default: 127.0.0.1). Only change to 0.0.0.0 on a trusted network.
HOST=127.0.0.1
PORT=8787

# Optional: server-side LLM defaults. These override values saved from the settings UI.
# The API key from the environment is never written to data/settings.json.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
